{
  "name": "n8n-nodes-gamma",
  "version": "0.1.6",
  "description": "n8n node for Gamma API - Generate AI-powered presentations, documents, and social posts",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "gamma",
    "presentation",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hamchowderr/n8n-nodes-gamma",
  "author": {
    "name": "chowderr",
    "email": "admin@otakusolutions.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamchowderr/n8n-nodes-gamma.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GammaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Gamma/Gamma.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.17.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
